# Database
# For local development with docker-compose, also set POSTGRES_PASSWORD to match
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
POSTGRES_USER="root"
POSTGRES_PASSWORD=""
POSTGRES_DB="local"

# Feature vars
WINNER_TRACKING_LAUNCH_DATE="YYYY-MM-DD"

# Auth secrets (generate random strings, e.g. openssl rand -base64 32)
AUTH_SECRET=""
CRON_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# External APIs
BGG_API_BASE_URL="https://boardgamegeek.com/xmlapi2"
STEAM_API_BASE_URL="https://store.steampowered.com/api"
STEAM_API_DETAILS_URL="https://store.steampowered.com/api/appdetails"
STEAM_API_USER_LIBRARY_URL="https://api.steampowered.com/IPlayerService/GetOwnedGames/v1"
STEAM_API_KEY=""

# Environment
NODE_ENV="development"

# Image storage (Vercel Blob - https://vercel.com/docs/storage/vercel-blob)
BLOB_READ_WRITE_TOKEN=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key must also be set as PUBLIC_VAPID_PUBLIC_KEY (client-safe)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL_ADDRESS=""
PUBLIC_VAPID_PUBLIC_KEY=""
